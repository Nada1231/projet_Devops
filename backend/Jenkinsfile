pipeline {
    agent any

    environment {
        JAVA_HOME = '/usr/lib/jvm/java-17-openjdk-amd64'
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Java version') {
            steps { sh 'java -version' }
        }
        stage('Build Maven') {
            steps {
                dir('backend') { sh 'mvn clean package -DskipTests' }
            }
        }
        stage('Tests') {
            steps {
                dir('backend') { sh 'mvn test' }
            }
        }
        stage('SonarQube') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar -Dsonar.projectKey=projet-devops -Dsonar.projectName=projet-devops'
                    }
                }
            }
        }
    }
}
